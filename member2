<style>
@property --vbm1A{syntax:'<angle>';inherits:false;initial-value:0deg}
@property --vbm1F{syntax:'<percentage>';inherits:false;initial-value:0%}

.vbm1{--night:#020a10;--ice:#dff1ff;--soft:#b5d3e6;--glow:#8fd0ff;--ember:#ff9d57;
  position:relative;overflow:hidden;isolation:isolate;max-width:560px;margin:0 auto;padding:40px 20px 28px;border-radius:32px;
  color:var(--ice);font-family:'Manrope',var(--t-text-font,system-ui),system-ui,sans-serif;text-align:center;
  background:linear-gradient(180deg,#041a22 0%,var(--night) 100%)}
.vbm1, .vbm1 *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
.vbm1::before{content:"";position:absolute;inset:0;pointer-events:none;z-index:-1;
  background-image:radial-gradient(1.2px 1.2px at 12% 4%,#fff 99%,transparent),radial-gradient(1px 1px at 78% 9%,#fff 99%,transparent),radial-gradient(1.6px 1.6px at 90% 22%,var(--ember) 99%,transparent),radial-gradient(1px 1px at 20% 33%,#cfe8ff 99%,transparent),radial-gradient(1.4px 1.4px at 6% 52%,var(--ember) 99%,transparent),radial-gradient(1px 1px at 84% 60%,#fff 99%,transparent),radial-gradient(1.2px 1.2px at 40% 78%,#cfe8ff 99%,transparent),radial-gradient(1px 1px at 92% 92%,#fff 99%,transparent),radial-gradient(1.4px 1.4px at 14% 94%,var(--ember) 99%,transparent)}
.vbm1-in{max-width:440px;margin:0 auto}

/* ===== brain ===== */
.vbm1-mind{max-width:300px;margin:0 auto 22px}
.vbm1-mind svg{display:block;width:100%;height:auto;overflow:visible}
.vbm1-nd{transform-box:fill-box;transform-origin:center;animation:vbm1nd 3.4s ease-in-out infinite}
@keyframes vbm1nd{0%,100%{opacity:.3;transform:scale(.7)}50%{opacity:1;transform:scale(1.5)}}
.vbm1-cr{transform-box:fill-box;transform-origin:center;animation:vbm1pl 5s ease-in-out infinite}
@keyframes vbm1pl{0%,100%{transform:scale(.92);opacity:.85}50%{transform:scale(1.08);opacity:1}}
.vbm1-dg{opacity:0;animation:vbm1up 7s ease-in infinite}
@keyframes vbm1up{0%{transform:translateY(0);opacity:0}15%{opacity:.85}65%{opacity:.55}100%{transform:translateY(-130px);opacity:0}}

/* ===== track headings ===== */
.vbm1-track{margin:0 0 56px}
.vbm1-track:last-child{margin-bottom:12px}
.vbm1 h3{margin:0 0 12px;font:300 32px/1.15 'Cormorant Garamond',var(--t-headline-font,Georgia),Georgia,serif;color:var(--ice);text-shadow:0 0 20px rgba(143,208,255,.35)}
.vbm1 .vbm1-get{margin:0 auto 28px!important;max-width:430px;font-size:15.5px;line-height:1.8;font-weight:300;color:var(--soft)}
.vbm1 .vbm1-q{margin:0 auto 12px;max-width:420px;font:italic 400 23px/1.4 'Cormorant Garamond',var(--t-headline-font,Georgia),Georgia,serif;color:#fff;text-shadow:0 0 18px rgba(143,208,255,.5)}

/* thin divider between tracks */
.vbm1-track + .vbm1-track{position:relative;padding-top:50px}
.vbm1-track + .vbm1-track::before{content:"";position:absolute;top:0;left:50%;width:min(440px,100%);height:1px;transform:translateX(-50%);background:linear-gradient(90deg,transparent,rgba(160,215,255,.35),transparent)}
.vbm1-track + .vbm1-track::after{content:"";position:absolute;top:-3px;left:50%;width:7px;height:7px;margin-left:-3.5px;border-radius:50%;background:var(--ember);box-shadow:0 0 12px 2px rgba(255,157,87,.7)}

/* ===== player ===== */
.vbm1-aud{display:flex;align-items:center;gap:16px;text-align:left;padding:18px;margin-bottom:16px;border-radius:22px;
  background:rgba(180,220,255,.08);border:1px solid rgba(190,230,255,.4);box-shadow:0 0 40px rgba(143,208,255,.18);transition:border-color .4s}
.vbm1-aud.is-playing{border-color:rgba(255,215,180,.5)}
.vbm1-play{flex:none;position:relative;width:54px;height:54px;padding:0;border-radius:50%;cursor:pointer;-webkit-appearance:none;appearance:none;
  border:1px solid rgba(255,200,150,.4);background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.22),rgba(143,208,255,.16) 55%,rgba(255,157,87,.16));box-shadow:0 0 12px rgba(143,208,255,.18)}
.vbm1-play::before{content:"";position:absolute;left:21px;top:16px;border-left:14px solid #fff;border-top:10px solid transparent;border-bottom:10px solid transparent;opacity:.92}
.vbm1-aud.is-playing .vbm1-play::before{left:19px;top:17px;width:5px;height:18px;border:0;border-radius:2px;background:#fff;box-shadow:11px 0 0 #fff}
.vbm1-aud .vbm1-tx{flex:1;min-width:0;margin:0!important;padding:0!important}
.vbm1-aud .vbm1-tt,.vbm1-aud .vbm1-ds,.vbm1-aud .vbm1-time{margin-bottom:0!important;padding:0!important}
.vbm1-aud .vbm1-tt{font:400 20px/1.25 'Cormorant Garamond',var(--t-headline-font,Georgia),Georgia,serif;color:#fff}
.vbm1-aud .vbm1-ds{margin-top:3px;font-size:13px;line-height:1.4;font-weight:300;color:#8fb2c6}
.vbm1-bar{position:relative;height:3px;margin-top:14px;border-radius:3px;background:rgba(160,215,255,.2);cursor:pointer}
.vbm1-bar::after{content:"";position:absolute;left:0;right:0;top:-12px;bottom:-12px}
.vbm1-bar i{display:block;height:100%;width:0;border-radius:3px;background:linear-gradient(90deg,var(--glow),var(--ember));box-shadow:0 0 5px rgba(255,157,87,.35)}
.vbm1-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:10px;min-height:34px}
.vbm1-time{font-size:11px;color:#6f93a8;letter-spacing:.04em}

/* ===== Repeat button: static when off, animated only when on ===== */
.vbm1-btn{position:relative;isolation:isolate;overflow:hidden;display:inline-block;padding:8px 20px;border-radius:999px;cursor:pointer;
  font:500 12px/1.2 'Manrope',var(--t-text-font,system-ui),system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#fff;
  border:1px solid rgba(255,200,150,.3);
  background:linear-gradient(120deg,rgba(143,208,255,.42),rgba(255,157,87,.38),rgba(190,160,255,.38),rgba(143,208,255,.42)) var(--vbm1F) 0 / 300% 100%;
  transition:transform .2s,border-color .4s}
.vbm1-btn:active{transform:scale(.96)}
.vbm1-btn:focus-visible{outline:2px solid var(--glow);outline-offset:3px}
.vbm1-btn::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;border-radius:inherit;opacity:0;
  background:radial-gradient(1.5px 1.5px at 12% 30%,#fff 99%,transparent),radial-gradient(1px 1px at 34% 72%,#ffd9b0 99%,transparent),radial-gradient(1.8px 1.8px at 58% 24%,#fff 99%,transparent),radial-gradient(1px 1px at 78% 70%,#cfe8ff 99%,transparent),radial-gradient(1.5px 1.5px at 92% 34%,#ffd9b0 99%,transparent)}
.vbm1-btn::after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;border-radius:inherit;padding:1.5px;opacity:0;
  background:conic-gradient(from var(--vbm1A),rgba(255,200,150,.3) 0 55%,rgba(255,217,176,.9) 80%,#fff 90%,rgba(255,200,150,.3) 100%);
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;
  mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0);mask-composite:exclude}
/* on: all animation starts here */
.vbm1-btn[aria-pressed="true"]{border-color:rgba(255,217,176,.9);
  animation:vbm1flow 4s ease-in-out infinite alternate}
.vbm1-btn[aria-pressed="true"]::before{opacity:1;animation:vbm1tw 2.2s ease-in-out infinite}
.vbm1-btn[aria-pressed="true"]::after{opacity:1;animation:vbm1ring 3.6s linear infinite}
@keyframes vbm1flow{from{--vbm1F:0%}to{--vbm1F:100%}}
@keyframes vbm1ring{to{--vbm1A:360deg}}
@keyframes vbm1tw{0%,100%{opacity:.12}50%{opacity:1}}

/* ===== module completion ===== */
.vbm1-end .vbm1-lbl{display:inline-block;margin:0;padding:6px 16px;border-radius:999px;border:1px solid rgba(255,200,150,.4);font:500 11px/1.2 'Manrope',var(--t-text-font,system-ui),system-ui,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#ffd9b0;background:rgba(255,157,87,.08)}
.vbm1-track.vbm1-end{padding-top:0}
.vbm1-track.vbm1-end::before,.vbm1-track.vbm1-end::after{display:none}
.vbm1 h3{text-wrap:balance}
.vbm1-end .vbm1-q{margin-bottom:0;font-size:26px}

/* hide the browser scrollbar indicator */
html{scrollbar-width:none}
html::-webkit-scrollbar{display:none}

@media (max-width:480px){.vbm1{padding:32px 22px 20px;border-radius:24px}.vbm1 h3{font-size:28px}.vbm1-aud{padding:16px;gap:14px}}
@media (max-width:360px){.vbm1{padding:26px 18px 18px;border-radius:20px}.vbm1 h3{font-size:25px}.vbm1-aud{padding:14px;gap:12px}}
@media (min-width:1200px){.vbm1{padding:46px 24px 32px}}
@media (prefers-reduced-motion:reduce){.vbm1-nd,.vbm1-cr{animation:none}.vbm1-dg{animation:none;opacity:.4}.vbm1-btn,.vbm1-btn::before,.vbm1-btn::after,.vbm1-btn[aria-pressed="true"],.vbm1-btn[aria-pressed="true"]::before,.vbm1-btn[aria-pressed="true"]::after{animation:none}}
</style>

