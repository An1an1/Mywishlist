<script>
(function(){
  var cur=null;
  function fmt(t){if(!isFinite(t))return'0:00';var m=Math.floor(t/60),s=Math.floor(t%60);return m+':'+(s<10?'0':'')+s}

  document.querySelectorAll('.vbm1-aud').forEach(function(c){
    var rep=c.getAttribute('data-repeat')==='true';
    c.innerHTML=
      '<button class="vbm1-play" type="button" aria-label="Play"></button>'+
      '<div class="vbm1-tx"><div class="vbm1-tt"></div><div class="vbm1-ds"></div>'+
      '<div class="vbm1-bar"><i></i></div>'+
      '<div class="vbm1-meta"><span class="vbm1-time">0:00 / 0:00</span>'+
      (rep?'<button class="vbm1-btn" type="button" aria-pressed="false">Repeat</button>':'')+
      '</div></div>';
    c.querySelector('.vbm1-tt').textContent=c.getAttribute('data-title')||'';
    c.querySelector('.vbm1-ds').textContent=c.getAttribute('data-desc')||'';

    var a=new Audio();a.preload='metadata';a.src=c.getAttribute('data-src');
    var b=c.querySelector('.vbm1-play'),bar=c.querySelector('.vbm1-bar'),f=bar.querySelector('i'),t=c.querySelector('.vbm1-time'),raf=0;
    function pos(){f.style.width=(a.duration?a.currentTime/a.duration*100:0)+'%'}
    function upd(){pos();t.textContent=fmt(a.currentTime)+' / '+fmt(a.duration)}
    function loop(){pos();raf=requestAnimationFrame(loop)}
    a.addEventListener('loadedmetadata',upd);
    a.addEventListener('timeupdate',upd);
    a.addEventListener('play',function(){c.classList.add('is-playing');cancelAnimationFrame(raf);raf=requestAnimationFrame(loop)});
    a.addEventListener('pause',function(){c.classList.remove('is-playing');cancelAnimationFrame(raf);upd()});
    a.addEventListener('ended',function(){cancelAnimationFrame(raf);c.classList.remove('is-playing');a.currentTime=0;upd()});
    a.addEventListener('seeked',upd);
    b.addEventListener('click',function(){
      if(a.paused){if(cur&&cur!==a)cur.pause();cur=a;var p=a.play();if(p&&p.catch)p.catch(function(){})}
      else a.pause();
    });
    bar.addEventListener('click',function(e){var r=bar.getBoundingClientRect();if(a.duration)a.currentTime=(e.clientX-r.left)/r.width*a.duration});

    if(rep){
      var rb=c.querySelector('.vbm1-btn');
      rb.addEventListener('click',function(){
        a.loop=!a.loop;
        rb.setAttribute('aria-pressed',a.loop?'true':'false');
        rb.textContent=a.loop?'Repeat on':'Repeat';
      });
    }
  });
})();
</script>
